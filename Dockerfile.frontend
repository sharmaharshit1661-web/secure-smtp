# ==============================================================================
# Secure SMTP — Enterprise Frontend Dockerfile
# ==============================================================================
# Multi-stage container: builds Vite React application and serves with Nginx Alpine.
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package manifests & install dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source code & build optimized bundle
COPY frontend/ ./
RUN npm run build

# ==============================================================================
# Runtime Stage (Nginx Alpine)
# ==============================================================================
FROM nginx:alpine AS runtime

# Remove default nginx configurations
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --retries=3 \
    CMD wget -q -O - http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
